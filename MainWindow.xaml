<Window x:Class="SjtuGuardian.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="校园网网络管家" Width="900" Height="730" MinWidth="700" MinHeight="600" Background="#F5F8FA">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="22">
   <DockPanel Margin="0,0,0,14">
    <TextBlock Text="校园网网络管家" FontSize="25" FontWeight="SemiBold" Foreground="#183542" DockPanel.Dock="Left"/>
    <Button x:Name="ToggleButton" Content="关闭保护" DockPanel.Dock="Right" Width="104" Margin="8,0,0,0" Click="Toggle_Click"/>
    <Button x:Name="RefreshButton" Content="刷新状态" DockPanel.Dock="Right" Width="90" Click="Refresh_Click"/>
   </DockPanel>
   <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock x:Name="Headline" Text="正在读取本机状态…" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="Summary" Margin="0,8,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="EvidenceTime" Margin="0,6,0,0" Foreground="#657782"/>
    </StackPanel>
   </Border>
   <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="DNS 与校园网可见性" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="DnsStatus" Margin="0,8,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="严格 DoH 只保护系统 DNS 查询。校园网仍可能看到目标 IP、连接时间及部分 TLS 元数据；不能据此断言未被监听。" Margin="0,8,0,0" Foreground="#657782" TextWrapping="Wrap"/>
     <DockPanel Margin="0,12,0,0">
      <Button Content="深度检查端口 53（约 10 秒）" Width="220" Click="Capture_Click" DockPanel.Dock="Left"/>
      <TextBlock x:Name="CaptureResult" Margin="12,5,0,0" Text="未运行；只有点击后才抓包" TextWrapping="Wrap"/>
     </DockPanel>
    </StackPanel>
   </Border>
   <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="游戏快检" FontSize="17" FontWeight="SemiBold"/>
     <DockPanel Margin="0,10,0,0"><Button Content="开始检测" Width="90" Click="Game_Click" DockPanel.Dock="Left"/><TextBlock Text="测 DNS、网关往返和登录服务 TCP；不是游戏内实际延迟" Margin="12,5,0,0" Foreground="#657782"/></DockPanel>
     <TextBox x:Name="GameResult" Margin="0,10,0,0" Height="90" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F6F8FA"/>
    </StackPanel>
   </Border>
   <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="公网出口" FontSize="17" FontWeight="SemiBold"/>
     <DockPanel Margin="0,10,0,0"><Button Content="检测出口" Width="90" Click="Exit_Click" DockPanel.Dock="Left"/><TextBlock Text="仅点击时访问 ipify；比较不使用／遵循系统 HTTP 代理，VPN/TUN 仍可能承载两者" Margin="12,5,0,0" Foreground="#657782"/></DockPanel>
     <TextBlock x:Name="ExitResult" Text="未查询" Margin="0,9,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Expander Header="整机网络状态（物理与虚拟网卡、地址、DNS、默认路由、代理）" Background="White" Padding="16" FontSize="16" IsExpanded="True">
    <StackPanel>
     <DockPanel Margin="0,0,0,8"><ComboBox x:Name="EnrollmentChoices" Width="245" DockPanel.Dock="Left"/><Button Content="将这张物理网卡加入校园保护" Width="205" Margin="8,0,0,0" Click="Enroll_Click" DockPanel.Dock="Left"/><TextBlock Text="仅在明确确认它接入校园网后使用" Margin="10,4,0,0" FontSize="12" Foreground="#657782"/></DockPanel>
     <TextBox x:Name="NetworkDetails" Height="175" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
   </Expander>
   <DockPanel Margin="0,14,0,0"><Button Content="预览匿名诊断导出" Width="150" Click="Export_Click" DockPanel.Dock="Left"/><TextBlock Text="默认不导出地址、MAC、设备名或代理节点" Margin="12,5,0,0" Foreground="#657782"/></DockPanel>
   <TextBlock Text="本程序无遥测、云账户、后台测速或持续抓包。抓包临时文件在汇总后删除。" Foreground="#657782" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</Window>
